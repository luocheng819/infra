# 复制为 backend/.env 后按需修改。所有变量前缀均为 LLMD_

# 数据目录（SQLite 与模型文件）
# LLMD_DATA_DIR=./data

# 安全：生产环境务必替换为随机长字符串
# LLMD_SECRET_KEY=please-change-me-to-a-long-random-string
# LLMD_ACCESS_TOKEN_TTL_MINUTES=720

# 初始管理员（仅首次建库时生效）
# LLMD_BOOTSTRAP_ADMIN_USERNAME=admin
# LLMD_BOOTSTRAP_ADMIN_PASSWORD=admin123

# 推理引擎
# LLMD_DEFAULT_ENGINE=mock

# 实例端口分配区间
# LLMD_PORT_RANGE_START=8100
# LLMD_PORT_RANGE_END=8199

# 健康巡检与指标采样周期（秒）
# LLMD_HEALTH_CHECK_INTERVAL_SECONDS=5
# LLMD_METRICS_RETENTION_POINTS=240

# 允许跨域的前端来源
# LLMD_CORS_ORIGINS=["http://localhost:5173"]
